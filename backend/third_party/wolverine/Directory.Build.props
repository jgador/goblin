<Project>
  <Import Project="../../Directory.Build.props" />
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <Version>6.39.1</Version>
    <IsPackable>false</IsPackable>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Authors>Jeremy D. Miller;Babu Annamalai;Jaedyn Tonee</Authors>
    <RepositoryUrl>https://github.com/JasperFx/wolverine</RepositoryUrl>
    <NoWarn>$(NoWarn);0618;1570;1571;1572;1573;1574;1587;1591;1701;1702;1711;1735</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Link="licenses/wolverine/LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
