{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2024"],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true
  },
  "include": [
    "config/**/*.mts",
    "scripts/**/*.mts",
    "frontend/scripts/**/*.mts",
    "tests/fixtures/**/*.mts"
  ]
}
