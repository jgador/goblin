{
  "name": "goblin-auth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": ["frontend"],
  "scripts": {
    "install:local": "python3 deploy/local/install.py",
    "setup:password": "python3 deploy/local/password.py",
    "build:assets": "npm run build --workspace frontend",
    "build:tools": "node scripts/clean-output.mjs && tsc -p tsconfig.json",
    "build:backend": "dotnet build backend/Goblin.slnx --nologo",
    "build": "npm run build:assets && npm run build:tools && npm run build:backend",
    "typecheck": "npm run typecheck --workspace frontend && tsc -p tsconfig.json --noEmit && npm run build:backend",
    "prestart": "npm run build",
    "start": "python3 deploy/local/start.py",
    "pretest": "npm run build",
    "test": "npm run protocol:check && dotnet test backend/Goblin.slnx --no-build --nologo && node --test dist/tests/integration/*.test.js dist/tests/deployment/*.test.js",
    "protocol:generate": "python3 backend/scripts/generate-protocol.py",
    "protocol:check": "python3 backend/scripts/generate-protocol.py --check",
    "secrets:setup": "node scripts/install-git-hooks.mjs",
    "secrets:scan": "node scripts/check-secrets.mjs",
    "secrets:staged": "node scripts/check-secrets.mjs staged",
    "secrets:history": "node scripts/check-secrets.mjs history",
    "test:secrets": "node --test scripts/check-secrets.test.mjs",
    "pretest:codex": "npm run build",
    "test:codex": "node dist/scripts/check-codex.js",
    "pretest:browser": "npm run build",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@openai/codex": "0.154.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.4",
    "typescript": "7.0.2"
  }
}
