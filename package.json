{
  "name": "goblin-auth-preview",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:assets": "node scripts/clean-assets.mjs && tsc -p tsconfig.json && tsc -p tsconfig.browser.json && node dist/scripts/copy-assets.js",
    "build": "npm run build:assets && dotnet build Goblin.slnx --nologo",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.browser.json --noEmit && dotnet build Goblin.slnx --nologo",
    "prestart": "npm run build",
    "start": "dotnet src/Goblin.Web/bin/Debug/net10.0/Goblin.Web.dll",
    "pretest": "npm run build",
    "test": "npm run protocol:check && dotnet test Goblin.slnx --no-build --nologo && node --test dist/test/*.test.js",
    "protocol:generate": "python3 scripts/generate-protocol.py",
    "protocol:check": "python3 scripts/generate-protocol.py --check",
    "secrets:setup": "node scripts/install-git-hooks.mjs",
    "secrets:scan": "node scripts/check-secrets.mjs",
    "secrets:staged": "node scripts/check-secrets.mjs staged",
    "secrets:history": "node scripts/check-secrets.mjs history",
    "test:secrets": "node --test scripts/check-secrets.test.mjs",
    "pretest:codex": "npm run build",
    "test:codex": "node dist/scripts/check-codex.js",
    "pretest:browser": "npm run build",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@openai/codex": "0.154.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.4",
    "typescript": "7.0.2"
  }
}
