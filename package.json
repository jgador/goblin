{
  "name": "goblin-auth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": ["frontend"],
  "scripts": {
    "install:local": "python3 deploy/local/install.py",
    "setup:password": "python3 deploy/local/password.py",
    "build:assets": "npm run build --workspace frontend",
    "build:tools": "node scripts/clean-output.mts && npm run typecheck:scripts && tsc -p tsconfig.json",
    "build:backend": "dotnet build backend/Goblin.slnx --nologo",
    "build": "npm run build:assets && npm run build:tools && npm run build:backend",
    "typecheck": "npm run typecheck --workspace frontend && npm run typecheck:scripts && tsc -p tsconfig.json --noEmit && npm run build:backend",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "format:typescript": "prettier --write --ignore-path .gitignore \"**/*.{ts,tsx,mts,cts}\"",
    "format:python": ".venv/bin/python scripts/format-python.py",
    "prestart": "npm run build",
    "start": "python3 deploy/local/start.py",
    "pretest": "npm run build",
    "test": "npm run protocol:check && npm run kubernetes:check && dotnet test backend/Goblin.slnx --no-build --nologo && node --test dist/tests/integration/*.test.js dist/tests/deployment/*.test.js",
    "protocol:generate": "dotnet run --file backend/scripts/GenerateProtocol.cs",
    "protocol:check": "dotnet run --file backend/scripts/GenerateProtocol.cs -- --self-test --check",
    "kubernetes:generate": "dotnet run --file backend/scripts/GenerateKubernetes.cs",
    "kubernetes:check": "dotnet run --file backend/scripts/GenerateKubernetes.cs -- --self-test --check",
    "secrets:setup": "node scripts/install-git-hooks.mts",
    "secrets:scan": "node scripts/check-secrets.mts",
    "secrets:staged": "node scripts/check-secrets.mts staged",
    "secrets:history": "node scripts/check-secrets.mts history",
    "test:secrets": "node --test scripts/check-secrets.test.mts",
    "pretest:codex": "npm run build",
    "test:codex": "node dist/scripts/check-codex.js",
    "pretest:headlamp": "npm run build",
    "test:headlamp": "node dist/scripts/check-headlamp.js",
    "pretest:browser": "npm run build",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@openai/codex": "0.155.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.4",
    "prettier": "3.9.8",
    "typescript": "7.0.2"
  }
}
