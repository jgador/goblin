# Included by Makefile; shared shell and tool settings live there.
# Targets use <scope>-<action>[-<qualifier>] and are grouped by scope.
DB_PROFILE ?= wsl

# =============================================================================
# Codex: direct invocation of the pinned runtime.
# =============================================================================
.PHONY: codex-run

# Invoke the locked Codex npm runtime directly without downloading another version.
codex-run:
	node node_modules/@openai/codex/bin/codex.js $(ARGS)

# =============================================================================
# Database: selected-profile migration, EF scaffolding, and opt-in tests.
# =============================================================================
.PHONY: database-migrate database-scaffold database-test

# Apply SQL migrations using the selected PostgreSQL profile.
database-migrate:
	cargo xtask database-migrate --profile "$(DB_PROFILE)"

# Regenerate EF mappings using the selected PostgreSQL profile.
database-scaffold:
	cargo xtask database-scaffold --profile "$(DB_PROFILE)"

# Run opt-in database integration tests on a development installation.
database-test:
	cargo xtask test-postgres --profile "$(DB_PROFILE)"

# =============================================================================
# Relay: an existing Azure HTTPS test gateway for local Goblin development.
# =============================================================================
.PHONY: relay-start relay-status relay-stop

# Connect a dedicated Azure HTTPS test installation to the local Goblin build.
relay-start:
	cargo xtask relay start $(ARGS)

# Inspect the selected development upstream and tunnel.
relay-status:
	cargo xtask relay status

# Restore the test VM's installed Goblin upstream and stop the owned relay.
relay-stop:
	cargo xtask relay stop

# =============================================================================
# Dev: direct application startup for fast WSL development.
# =============================================================================
.PHONY: dev-start

# Build the application, provision local credentials, and launch the .NET host.
dev-start: build
	cargo xtask dev --profile "$(DB_PROFILE)" $(ARGS)

# =============================================================================
# Docker: timed platform builds and image/cache cleanup.
# =============================================================================
.PHONY: docker-build docker-clean-images docker-clean-cache

# Time the complete Goblin image build; pass extra Docker flags with ARGS.
docker-build:
	time docker build --platform linux/amd64 --progress=plain \
		-t goblin-platform:local $(ARGS) .

# Remove Goblin image tags, including registry-qualified names.
docker-clean-images:
	docker image ls --format '{{.Repository}}:{{.Tag}}' \
		| awk -F/ '$$NF ~ /^goblin[^:]*:/ { print }' \
		| xargs -r docker image rm

# Clear unused cache for the default Docker builder across all projects.
docker-clean-cache:
	docker builder prune --all --force

# =============================================================================
# Goblinctl: operator CLI invocation from source.
# =============================================================================
.PHONY: goblinctl-run

# Run the operator CLI from source with arguments supplied through ARGS.
goblinctl-run:
	cargo run --locked --package goblinctl -- $(ARGS)

# =============================================================================
# K3s: owned WSL installation, cached application deployment, and inspection.
# =============================================================================
.PHONY: k3s-run k3s-start k3s-deploy k3s-status k3s-stop k3s-reset k3s-logs k3s-retry k3s-configure-database k3s-locate-password

# Run a local installer command from source with arguments supplied through ARGS.
k3s-run:
	cargo run --locked -q -p goblinctl -- k3s $(ARGS)

# Install or resume the owned WSL k3s environment.
k3s-start:
	cargo run --locked -q -p goblinctl -- k3s start $(ARGS)

# Deploy the current Goblin image and explicit application settings to WSL k3s.
k3s-deploy:
	cargo run --locked -q -p goblinctl -- k3s deploy $(ARGS)

# Report local installation status without starting or resetting it.
k3s-status:
	cargo run --locked -q -p goblinctl -- k3s status $(ARGS)

# Stop the owned local installation using the existing operator CLI.
k3s-stop:
	cargo run --locked -q -p goblinctl -- k3s stop $(ARGS)

# Remove the owned WSL cluster, data and saved password without a confirmation flag.
k3s-reset:
	cargo run --locked -q -p goblinctl -- k3s reset --yes $(ARGS)

# Read local installation logs; use ARGS=--follow to stream them.
k3s-logs:
	cargo run --locked -q -p goblinctl -- k3s logs $(ARGS)

# Explicitly retry a failed local installation using the operator CLI.
k3s-retry:
	cargo run --locked -q -p goblinctl -- k3s retry $(ARGS)

# Configure the local installation’s PostgreSQL host endpoint on port 5432.
k3s-configure-database:
	cargo run --locked -q -p goblinctl -- k3s database $(ARGS)

# Report the local password verifier location through the operator CLI.
k3s-locate-password:
	cargo run --locked -q -p goblinctl -- k3s password $(ARGS)

# =============================================================================
# Password: local owner password selection.
# =============================================================================
.PHONY: password-set

# Choose and confirm a local password; use ARGS=--replace to replace its verifier.
password-set:
	cargo run --locked -q -p goblinctl -- password set $(ARGS)

# =============================================================================
# Website: Docker development, local k3s deployment, and load testing.
# =============================================================================
.PHONY: website-start website-stop website-status website-logs website-deploy website-preview website-test-load

# Start the standalone website in Docker, detached, with browser live reload.
website-start:
	bash website/manage.sh dev $(ARGS)

# Stop the website development container without affecting the application.
website-stop:
	bash website/manage.sh stop $(ARGS)

# Show the website development container's status.
website-status:
	bash website/manage.sh status $(ARGS)

# Read website development logs; use ARGS=--follow to stream them.
website-logs:
	bash website/manage.sh logs $(ARGS)

# Build the static website, import it into local k3s, and wait for its rollout.
website-deploy:
	bash website/manage.sh deploy

# Forward the k3s website to localhost:5174; keep this terminal open.
website-preview:
	bash website/manage.sh preview

# Measure the k3s website container at one fresh browser visit per minute.
website-test-load:
	bash website/manage.sh load-test $(ARGS)
