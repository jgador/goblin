      },
      "type": "string",
      "value": "[if(empty(trim(parameters('adminSshPublicKey'))), 'No SSH key was supplied. An authorized Azure administrator can add a new public key later.', format('Keep your matching private key for later VM access. {0}', if(empty(trim(parameters('sshSourceAddressPrefix'))), 'Public SSH is closed; an administrator must allow port 22 from your IP before connecting.', 'Public SSH is restricted to the configured source IP or CIDR.')))]"
