{
  "$schema": "https://schema.management.azure.com/schemas/2021-09-09/uiFormDefinition.schema.json#",
  "view": {
    "kind": "Form",
    "properties": {
      "title": "Deploy Goblin",
      "steps": [
        {
          "name": "basics",
          "label": "Basics",
          "elements": [
            {
              "name": "resourceScope",
              "type": "Microsoft.Common.ResourceScope",
              "subscription": {
                "resourceProviders": [
                  "Microsoft.Compute",
                  "Microsoft.Network"
                ]
              },
              "location": {
                "resourceTypes": [
                  "Microsoft.Compute/virtualMachines"
                ]
              }
            },
            {
              "name": "companyName",
              "type": "Microsoft.Common.TextBox",
              "label": "Company or software name",
              "defaultValue": "Goblin",
              "toolTip": "Keep Goblin or replace it with your company or software name. Use 2–24 letters, numbers, spaces or hyphens, starting with a letter.",
              "constraints": {
                "required": true,
                "regex": "^[A-Za-z][A-Za-z0-9 -]{0,22}[A-Za-z0-9]$",
                "validationMessage": "Enter a valid value using the format described above."
              }
            },
            {
              "name": "environment",
              "type": "Microsoft.Common.DropDown",
              "label": "Environment",
              "defaultValue": "Production",
              "constraints": {
                "required": true,
                "allowedValues": [
                  {
                    "label": "Production",
                    "value": "prod"
                  },
                  {
                    "label": "Staging",
                    "value": "staging"
                  },
                  {
                    "label": "Test",
                    "value": "test"
                  },
                  {
                    "label": "Development",
                    "value": "dev"
                  }
                ]
              }
            },
            {
              "name": "installationInfo",
              "type": "Microsoft.Common.InfoBox",
              "options": {
                "style": "Info",
                "text": "This installs the Goblin infrastructure foundation. The Goblin application and HTTPS onboarding are not available yet. Installation failures appear in Azure's deployment page."
              }
            }
          ]
        },
        {
          "name": "access",
          "label": "Save your VM access key",
          "elements": [
            {
              "name": "saveKeyInfo",
              "type": "Microsoft.Common.InfoBox",
              "options": {
                "style": "Info",
                "text": "Choose Generate new key pair. When you create the deployment, Azure will ask you to download a private key file. Save this file somewhere safe: you will need it if you want to connect directly to your VM later. It is not needed for everyday Goblin use. Azure will not let you download the same private key again. You can also use an existing key."
              }
            },
            {
              "name": "adminUsername",
              "type": "Microsoft.Compute.UserNameTextBox",
              "label": "VM administrator username",
              "defaultValue": "goblinadmin",
              "toolTip": "Use this username with your saved key if you connect directly to the VM.",
              "osPlatform": "Linux",
              "constraints": {
                "required": true
              }
            },
            {
              "name": "credentials",
              "type": "Microsoft.Compute.CredentialsCombo",
              "label": {
                "authenticationType": "VM access method",
                "password": "Password",
                "confirmPassword": "Confirm password",
                "sshPublicKey": "VM access key"
              },
              "toolTip": {
                "authenticationType": "Create a key to save for later VM administration.",
                "sshPublicKey": "Generate a new key pair to download when deploying, choose a key stored in Azure, or supply your existing public key. Keep the matching private key on your computer."
              },
              "constraints": {
                "required": true
              },
              "options": {
                "hideConfirmation": false,
                "hidePassword": true
              },
              "osPlatform": "Linux"
            },
            {
              "name": "enableSshNow",
              "type": "Microsoft.Common.CheckBox",
              "label": "Enable direct SSH access now (advanced)"
            },
            {
              "name": "sshSourceAddressPrefix",
              "type": "Microsoft.Common.TextBox",
              "label": "Your allowed IP address or CIDR",
              "defaultValue": "",
              "toolTip": "For example, 203.0.113.10/32. Only this source can connect to port 22.",
              "constraints": {
                "required": "[steps('access').enableSshNow]",
                "regex": "^(?:[0-9]{1,3}\\.){3}[0-9]{1,3}(?:/(?:[0-9]|[12][0-9]|3[0-2]))?$",
                "validationMessage": "Enter a valid value using the format described above."
              },
              "visible": "[steps('access').enableSshNow]"
            },
            {
              "name": "sshInfo",
              "type": "Microsoft.Common.InfoBox",
              "options": {
                "style": "Info",
                "text": "Saving a key does not open the VM to SSH. Leave direct SSH access disabled unless you need it now. An authorized administrator can enable network access later through Azure."
              }
            }
          ]
        },
        {
          "name": "advanced",
          "label": "Advanced settings",
          "elements": [
            {
              "name": "vmSize",
              "type": "Microsoft.Common.TextBox",
              "label": "Virtual machine size",
              "defaultValue": "Standard_D4s_v5",
              "toolTip": "Default: 4 vCPUs and 16 GiB RAM. Choose an x64 VM size that supports Trusted Launch and is available in your region.",
              "constraints": {
                "required": true,
                "regex": "^Standard_[A-Za-z0-9_]+$",
                "validationMessage": "Enter a valid value using the format described above."
              }
            },
            {
              "name": "osDiskSizeGB",
              "type": "Microsoft.Common.DropDown",
              "label": "OS disk size",
              "defaultValue": "128 GiB",
              "constraints": {
                "required": true,
                "allowedValues": [
                  {
                    "label": "64 GiB",
                    "value": 64
                  },
                  {
                    "label": "128 GiB",
                    "value": 128
                  },
                  {
                    "label": "256 GiB",
                    "value": 256
                  },
                  {
                    "label": "512 GiB",
                    "value": 512
                  },
                  {
                    "label": "1024 GiB",
                    "value": 1024
                  }
                ]
              }
            },
            {
              "name": "virtualNetworkAddressPrefix",
              "type": "Microsoft.Common.TextBox",
              "label": "Virtual network address range",
              "defaultValue": "10.20.0.0/16",
              "toolTip": "Keep separate from K3s pod range 10.42.0.0/16 and service range 10.43.0.0/16.",
              "constraints": {
                "required": true,
                "regex": "^(?:[0-9]{1,3}\\.){3}[0-9]{1,3}/(?:[0-9]|[12][0-9]|3[0-2])$",
                "validationMessage": "Enter a valid value using the format described above."
              }
            },
            {
              "name": "subnetAddressPrefix",
              "type": "Microsoft.Common.TextBox",
              "label": "VM subnet address range",
              "defaultValue": "10.20.0.0/24",
              "toolTip": "Choose a subnet inside the virtual network address range.",
              "constraints": {
                "required": true,
                "regex": "^(?:[0-9]{1,3}\\.){3}[0-9]{1,3}/(?:[0-9]|[12][0-9]|3[0-2])$",
                "validationMessage": "Enter a valid value using the format described above."
              }
            },
            {
              "name": "nameOverrides",
              "type": "Microsoft.Common.Section",
              "label": "Optional resource-name overrides",
              "elements": [
                {
                  "name": "virtualMachineName",
                  "type": "Microsoft.Common.TextBox",
                  "label": "Virtual machine name",
                  "defaultValue": "",
                  "toolTip": "Leave blank for a name based on your company and environment. Default: vm-goblin-prod.",
                  "constraints": {
                    "required": false,
                    "regex": "^$|^[A-Za-z0-9](?:[A-Za-z0-9-]{0,62}[A-Za-z0-9])?$",
                    "validationMessage": "Enter a valid value using the format described above."
                  }
                },
                {
                  "name": "publicIpName",
                  "type": "Microsoft.Common.TextBox",
                  "label": "Public IP resource name",
                  "defaultValue": "",
                  "toolTip": "Leave blank for a name based on your company and environment. Default: pip-goblin-prod.",
                  "constraints": {
                    "required": false,
                    "regex": "^$|^[A-Za-z0-9](?:[A-Za-z0-9_.-]{0,78}[A-Za-z0-9_])?$",
                    "validationMessage": "Enter a valid value using the format described above."
                  }
                },
                {
                  "name": "virtualNetworkName",
                  "type": "Microsoft.Common.TextBox",
                  "label": "Virtual network name",
                  "defaultValue": "",
                  "toolTip": "Leave blank for a name based on your company and environment. Default: vnet-goblin-prod.",
                  "constraints": {
                    "required": false,
                    "regex": "^$|^[A-Za-z0-9](?:[A-Za-z0-9_.-]{0,62}[A-Za-z0-9_])?$",
                    "validationMessage": "Enter a valid value using the format described above."
                  }
                },
                {
                  "name": "subnetName",
                  "type": "Microsoft.Common.TextBox",
                  "label": "Subnet name",
                  "defaultValue": "",
                  "toolTip": "Leave blank for a name based on your company and environment. Default: snet-goblin-prod.",
                  "constraints": {
                    "required": false,
                    "regex": "^$|^[A-Za-z0-9](?:[A-Za-z0-9_.-]{0,78}[A-Za-z0-9_])?$",
                    "validationMessage": "Enter a valid value using the format described above."
                  }
                },
                {
                  "name": "networkInterfaceName",
                  "type": "Microsoft.Common.TextBox",
                  "label": "Network interface name",
                  "defaultValue": "",
                  "toolTip": "Leave blank for a name based on your company and environment. Default: nic-goblin-prod.",
                  "constraints": {
                    "required": false,
                    "regex": "^$|^[A-Za-z0-9](?:[A-Za-z0-9_.-]{0,78}[A-Za-z0-9_])?$",
                    "validationMessage": "Enter a valid value using the format described above."
                  }
                },
                {
                  "name": "networkSecurityGroupName",
                  "type": "Microsoft.Common.TextBox",
                  "label": "Network security group name",
                  "defaultValue": "",
                  "toolTip": "Leave blank for a name based on your company and environment. Default: nsg-goblin-prod.",
                  "constraints": {
                    "required": false,
                    "regex": "^$|^[A-Za-z0-9](?:[A-Za-z0-9_.-]{0,78}[A-Za-z0-9_])?$",
                    "validationMessage": "Enter a valid value using the format described above."
                  }
                },
                {
                  "name": "osDiskName",
                  "type": "Microsoft.Common.TextBox",
                  "label": "OS disk name",
                  "defaultValue": "",
                  "toolTip": "Leave blank for a name based on your company and environment. Default: osdisk-goblin-prod.",
                  "constraints": {
                    "required": false,
                    "regex": "^$|^[A-Za-z0-9](?:[A-Za-z0-9_.-]{0,78}[A-Za-z0-9_])?$",
                    "validationMessage": "Enter a valid value using the format described above."
                  }
                },
                {
                  "name": "dnsLabel",
                  "type": "Microsoft.Common.TextBox",
                  "label": "Public hostname prefix",
                  "defaultValue": "",
                  "toolTip": "Leave blank for a name based on your company and environment. Default: goblin-prod.",
                  "constraints": {
                    "required": false,
                    "regex": "^$|^[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?$",
                    "validationMessage": "Enter a valid value using the format described above."
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "outputs": {
      "kind": "Subscription",
      "subscriptionId": "[steps('basics').resourceScope.subscription.subscriptionId]",
      "location": "[steps('basics').resourceScope.location.name]",
      "parameters": {
        "companyName": "[steps('basics').companyName]",
        "resourceGroupName": "[steps('basics').resourceScope.resourceGroup.name]",
        "location": "[steps('basics').resourceScope.location.name]",
        "environment": "[steps('basics').environment]",
        "adminUsername": "[steps('access').adminUsername]",
        "adminSshPublicKey": "[steps('access').credentials.sshPublicKey]",
        "sshSourceAddressPrefix": "[if(steps('access').enableSshNow, steps('access').sshSourceAddressPrefix, '')]",
        "vmSize": "[steps('advanced').vmSize]",
        "osDiskSizeGB": "[steps('advanced').osDiskSizeGB]",
        "virtualNetworkAddressPrefix": "[steps('advanced').virtualNetworkAddressPrefix]",
        "subnetAddressPrefix": "[steps('advanced').subnetAddressPrefix]",
        "virtualMachineName": "[steps('advanced').nameOverrides.virtualMachineName]",
        "publicIpName": "[steps('advanced').nameOverrides.publicIpName]",
        "virtualNetworkName": "[steps('advanced').nameOverrides.virtualNetworkName]",
        "subnetName": "[steps('advanced').nameOverrides.subnetName]",
        "networkInterfaceName": "[steps('advanced').nameOverrides.networkInterfaceName]",
        "networkSecurityGroupName": "[steps('advanced').nameOverrides.networkSecurityGroupName]",
        "osDiskName": "[steps('advanced').nameOverrides.osDiskName]",
        "dnsLabel": "[steps('advanced').nameOverrides.dnsLabel]"
      }
    }
  }
}
