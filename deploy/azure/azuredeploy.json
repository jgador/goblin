{
  "$schema": "https://schema.management.azure.com/schemas/2018-05-01/subscriptionDeploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.47.16.16243",
      "templateHash": "1577556314430617913"
    }
  },
  "parameters": {
    "companyName": {
      "type": "string",
      "defaultValue": "Goblin",
      "minLength": 2,
      "maxLength": 24,
      "metadata": {
        "description": "Company or software name. Keep Goblin or replace it with your own name. Use letters, numbers, spaces or hyphens, starting with a letter. Spaces become hyphens and letters become lowercase in default resource names."
      }
    },
    "goblinPassword": {
      "type": "securestring",
      "maxLength": 128,
      "metadata": {
        "description": "Password for opening Goblin. A password is required, with no minimum length or character-mix requirement (up to 128 characters). This is separate from your Azure, SSH, and AI provider credentials. Use the same password when redeploying unless you intend to change it."
      }
    },
    "adminSshPublicKey": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Public part of the VM access key. The guided portal form supplies it after key generation and private-key download. For CLI deployment, supply an existing public key or leave blank for setup without SSH. Never supply a private key. Set sshSourceAddressPrefix only when direct SSH access is needed."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[deployment().location]",
      "metadata": {
        "description": "Azure region for the resource group and VM. Defaults to the subscription deployment location."
      }
    },
    "environment": {
      "type": "string",
      "defaultValue": "prod",
      "allowedValues": [
        "dev",
        "test",
        "staging",
        "prod"
      ],
      "metadata": {
        "description": "Environment included in generated names. No instance number is appended."
      }
    },
    "goblinSourceRef": {
      "type": "string",
      "defaultValue": "master",
      "minLength": 1,
      "maxLength": 128,
      "metadata": {
        "description": "Goblin branch, tag, or commit to build from github.com/jgador/goblin. Use a commit SHA for repeatable installations; master follows the current application."
      }
    },
    "adminUsername": {
      "type": "string",
      "defaultValue": "goblinadmin",
      "metadata": {
        "description": "Linux administrator username."
      }
    },
    "vmSize": {
      "type": "string",
      "defaultValue": "Standard_D4s_v5",
      "metadata": {
        "description": "VM size. The default provides 4 vCPUs and 16 GiB RAM; verify regional availability and pricing before deploying. Use an x64 size."
      }
    },
    "osDiskSizeGB": {
      "type": "int",
      "defaultValue": 128,
      "minValue": 64,
      "maxValue": 1024,
      "metadata": {
        "description": "OS disk capacity in GiB. Kubernetes data is stored on this managed disk."
      }
    },
    "sshSourceAddressPrefix": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Optional advanced setting: source IP/CIDR allowed to connect over SSH, for example 203.0.113.10/32. Public SSH is enabled only when this setting and adminSshPublicKey are both supplied. Azure Portal Run Command remains available without SSH."
      }
    },
    "virtualNetworkAddressPrefix": {
      "type": "string",
      "defaultValue": "10.20.0.0/16",
      "metadata": {
        "description": "Virtual network address range. Keep it separate from the K3s pod range 10.42.0.0/16 and service range 10.43.0.0/16."
      }
    },
    "subnetAddressPrefix": {
      "type": "string",
      "defaultValue": "10.20.0.0/24",
      "metadata": {
        "description": "VM subnet address range, contained in the virtual network range."
      }
    },
    "resourceGroupName": {
      "type": "string",
      "defaultValue": "",
      "maxLength": 90,
      "metadata": {
        "description": "Optional resource group name. Blank uses the generated name (default: rg-goblin-prod). Use a dedicated resource group."
      }
    },
    "virtualMachineName": {
      "type": "string",
      "defaultValue": "",
      "maxLength": 64,
      "metadata": {
        "description": "Optional VM name. Blank uses the generated name (default: vm-goblin-prod). Must also be a valid Linux hostname."
      }
    },
    "publicIpName": {
      "type": "string",
      "defaultValue": "",
      "maxLength": 80,
      "metadata": {
        "description": "Optional public IP resource name. Blank uses the generated name (default: pip-goblin-prod). This is separate from the DNS label."
      }
    },
    "virtualNetworkName": {
      "type": "string",
      "defaultValue": "",
      "maxLength": 64,
      "metadata": {
        "description": "Optional virtual network name. Blank uses the generated name (default: vnet-goblin-prod)."
      }
    },
    "subnetName": {
      "type": "string",
      "defaultValue": "",
      "maxLength": 80,
      "metadata": {
        "description": "Optional subnet name. Blank uses the generated name (default: snet-goblin-prod)."
      }
    },
    "networkInterfaceName": {
      "type": "string",
      "defaultValue": "",
      "maxLength": 80,
      "metadata": {
        "description": "Optional network interface name. Blank uses the generated name (default: nic-goblin-prod)."
      }
    },
    "networkSecurityGroupName": {
      "type": "string",
      "defaultValue": "",
      "maxLength": 80,
      "metadata": {
        "description": "Optional network security group name. Blank uses the generated name (default: nsg-goblin-prod)."
      }
    },
    "osDiskName": {
      "type": "string",
      "defaultValue": "",
      "maxLength": 80,
      "metadata": {
        "description": "Optional OS disk name. Blank uses the generated name (default: osdisk-goblin-prod)."
      }
    },
    "dnsLabel": {
      "type": "string",
      "defaultValue": "",
      "maxLength": 63,
      "metadata": {
        "description": "Optional Azure public DNS label. Blank uses the generated label (default: goblin-prod). Use lowercase letters, numbers and hyphens, starting with a letter and ending with a letter or number. Must be available in the region; choose another label if occupied."
      }
    }
  },
  "variables": {
    "companyPrefix": "[replace(toLower(trim(parameters('companyName'))), ' ', '-')]",
    "workloadPrefix": "[if(equals(variables('companyPrefix'), 'goblin'), 'goblin', format('{0}-goblin', variables('companyPrefix')))]",
    "nameBase": "[format('{0}-{1}', variables('workloadPrefix'), parameters('environment'))]",
    "names": {
      "resourceGroup": "[if(empty(trim(parameters('resourceGroupName'))), format('rg-{0}', variables('nameBase')), trim(parameters('resourceGroupName')))]",
      "virtualMachine": "[if(empty(trim(parameters('virtualMachineName'))), format('vm-{0}', variables('nameBase')), trim(parameters('virtualMachineName')))]",
      "publicIp": "[if(empty(trim(parameters('publicIpName'))), format('pip-{0}', variables('nameBase')), trim(parameters('publicIpName')))]",
      "virtualNetwork": "[if(empty(trim(parameters('virtualNetworkName'))), format('vnet-{0}', variables('nameBase')), trim(parameters('virtualNetworkName')))]",
      "subnet": "[if(empty(trim(parameters('subnetName'))), format('snet-{0}', variables('nameBase')), trim(parameters('subnetName')))]",
      "networkInterface": "[if(empty(trim(parameters('networkInterfaceName'))), format('nic-{0}', variables('nameBase')), trim(parameters('networkInterfaceName')))]",
      "networkSecurityGroup": "[if(empty(trim(parameters('networkSecurityGroupName'))), format('nsg-{0}', variables('nameBase')), trim(parameters('networkSecurityGroupName')))]",
      "osDisk": "[if(empty(trim(parameters('osDiskName'))), format('osdisk-{0}', variables('nameBase')), trim(parameters('osDiskName')))]"
    },
    "effectiveDnsLabel": "[if(empty(trim(parameters('dnsLabel'))), variables('nameBase'), trim(parameters('dnsLabel')))]",
    "tags": {
      "application": "goblin",
      "company": "[trim(parameters('companyName'))]",
      "environment": "[parameters('environment')]",
      "managedBy": "goblin-arm"
    }
  },
  "resources": [
    {
      "type": "Microsoft.Resources/resourceGroups",
      "apiVersion": "2025-04-01",
      "name": "[variables('names').resourceGroup]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]"
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "goblin-infrastructure",
      "resourceGroup": "[variables('names').resourceGroup]",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "location": {
            "value": "[parameters('location')]"
          },
          "names": {
            "value": "[variables('names')]"
          },
          "tags": {
            "value": "[variables('tags')]"
          },
          "dnsLabel": {
            "value": "[variables('effectiveDnsLabel')]"
          },
          "adminUsername": {
            "value": "[parameters('adminUsername')]"
          },
          "adminSshPublicKey": {
            "value": "[parameters('adminSshPublicKey')]"
          },
          "goblinPassword": {
            "value": "[parameters('goblinPassword')]"
          },
          "goblinSourceRef": {
            "value": "[parameters('goblinSourceRef')]"
          },
          "vmSize": {
            "value": "[parameters('vmSize')]"
          },
          "osDiskSizeGB": {
            "value": "[parameters('osDiskSizeGB')]"
          },
          "sshSourceAddressPrefix": {
            "value": "[trim(parameters('sshSourceAddressPrefix'))]"
          },
          "virtualNetworkAddressPrefix": {
            "value": "[parameters('virtualNetworkAddressPrefix')]"
          },
          "subnetAddressPrefix": {
            "value": "[parameters('subnetAddressPrefix')]"
          }
        },
