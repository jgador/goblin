            "$fxv#1": "#!/usr/bin/env bash\n# Azure Custom Script launches scripts through /bin/sh; ensure Bash semantics.\nif [ -z \"${BASH_VERSION:-}\" ]; then\n  exec /bin/bash \"$0\" \"$@\"\nfi\nset +x\nset -Eeuo pipefail\numask 077\n\n# Public status is readable by the unprivileged UI; configuration is root-only.\ninstall -d -m 0751 /var/lib/goblin\ninstall -d -m 0755 /var/lib/goblin/install\ninstall -d -m 0700 /var/lib/goblin/install/private\nexec > >(tee -a /var/log/goblin-bootstrap.log) 2>&1\nprintf 'running\\n' > /var/lib/goblin/bootstrap-status\nbootstrap_dir=''\ncurrent_stage='Preparing the server'\nstage() { current_stage=$1; printf '[Goblin] %s\\n' \"$current_stage\"; }\nfinish() {\n  local result=$?\n  if [[ \"$result\" != 0 ]]; then\n    printf 'failed\\n' > /var/lib/goblin/bootstrap-status\n    printf '[Goblin] Setup failed during: %s (exit code %s).\\n' \"$current_stage\" \"$result\" >&2\n  fi\n  if [[ -n \"$bootstrap_dir\" ]]; then rm -rf \"$bootstrap_dir\"; fi\n  exit \"$result\"\n}\ntrap finish EXIT\n\nif command -v cloud-init >/dev/null; then\n  cloud_init_result=0\n  cloud-init status --wait || cloud_init_result=$?\n  if [[ \"$cloud_init_result\" != 0 && \"$cloud_init_result\" != 2 ]]; then exit \"$cloud_init_result\"; fi\nfi\nif ! command -v curl >/dev/null || ! command -v tar >/dev/null; then\n  apt-get -o DPkg::Lock::Timeout=300 update\n  DEBIAN_FRONTEND=noninteractive apt-get -o DPkg::Lock::Timeout=300 install -y ca-certificates curl tar\nfi\nbootstrap_dir=$(mktemp -d /var/lib/goblin/bootstrap.XXXXXX)\n\n# ARM encodes all user-supplied values before embedding them in shell source.\ngoblin_hostname=$(printf '%s' '__GOBLIN_HOSTNAME_BASE64__' | base64 --decode)\ngoblin_source_ref=$(printf '%s' '__GOBLIN_SOURCE_REF_BASE64__' | base64 --decode)\nif [[ \"$goblin_hostname\" != localhost && ! \"$goblin_hostname\" =~ ^([a-z0-9]([a-z0-9-]*[a-z0-9])?\\.)+[a-z]{2,}$ ]] || \\\n   [[ ! \"$goblin_source_ref\" =~ ^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$ ]]; then\n  printf 'Invalid public hostname or Goblin source ref.\\n' >&2\n  exit 1\nfi\nstage 'Preparing native Goblin administration tooling'\ngoblinctl_version='__GOBLINCTL_VERSION__'\ngoblinctl_sha256='__GOBLINCTL_SHA256__'\nif [[ \"$(uname -m)\" != x86_64 ]]; then printf 'Goblin requires an x86-64 host.\\n' >&2; exit 1; fi\nif [[ -n \"${GOBLINCTL_LOCAL_BINARY:-}\" ]]; then\n  # Explicit developer input: never compiled or downloaded on the installed host.\n  [[ \"${GOBLINCTL_LOCAL_SHA256:-}\" =~ ^[a-f0-9]{64}$ ]]\n  install -m 0755 \"$GOBLINCTL_LOCAL_BINARY\" \"$bootstrap_dir/goblinctl\"\n  printf '%s  %s\\n' \"$GOBLINCTL_LOCAL_SHA256\" \"$bootstrap_dir/goblinctl\" | sha256sum --check\nelse\n  [[ \"$goblinctl_version\" =~ ^[0-9]+\\.[0-9]+\\.[0-9]+$ && \"$goblinctl_sha256\" =~ ^[a-f0-9]{64}$ ]]\n  curl --fail --silent --show-error --location --proto '=https' --proto-redir '=https' \\\n    --retry 5 --connect-timeout 15 --max-time 300 \\\n    \"https://github.com/jgador/goblin/releases/download/goblinctl-v${goblinctl_version}/goblinctl-x86_64-unknown-linux-musl.tar.gz\" \\\n    --output \"$bootstrap_dir/goblinctl.tar.gz\"\n  printf '%s  %s\\n' \"$goblinctl_sha256\" \"$bootstrap_dir/goblinctl.tar.gz\" | sha256sum --check\n  [[ \"$(tar -tzf \"$bootstrap_dir/goblinctl.tar.gz\")\" == goblinctl ]]\n  tar --extract --gzip --file \"$bootstrap_dir/goblinctl.tar.gz\" --directory \"$bootstrap_dir\" --no-same-owner --no-same-permissions goblinctl\n  chmod 0755 \"$bootstrap_dir/goblinctl\"\nfi\n[[ \"$(\"$bootstrap_dir/goblinctl\" --version)\" == \"goblinctl $goblinctl_version\" ]]\n\nstage 'Preparing the Goblin password'\nif [[ -n \"${GOBLIN_PASSWORD_HASH_FILE:-}\" ]]; then\n  \"$bootstrap_dir/goblinctl\" internal validate-password \"$GOBLIN_PASSWORD_HASH_FILE\"\n  install -m 0600 \"$GOBLIN_PASSWORD_HASH_FILE\" \"$bootstrap_dir/owner-password\"\nelse\n  printf '%s' '__GOBLIN_PASSWORD_BASE64__' | base64 --decode | \\\n    \"$bootstrap_dir/goblinctl\" internal hash-password > \"$bootstrap_dir/owner-password\"\nfi\n\n# Reprovisioning explicitly starts a new attempt and can update the owner password.\n# Stop the old worker (including recovery) before replacing its executable/config.\nif systemctl cat goblin-installer.service >/dev/null 2>&1; then systemctl stop goblin-installer.service; fi\nexec 9>/var/lib/goblin/install/installer.lock\nflock -w 420 9\nif systemctl cat goblin-setup.service >/dev/null 2>&1; then systemctl stop goblin-setup.service; fi\n\"$bootstrap_dir/goblinctl\" internal activate --binary \"$bootstrap_dir/goblinctl\"\nexport GOBLINCTL=/opt/goblin/bin/goblinctl\ninstall -m 0600 \"$bootstrap_dir/owner-password\" /var/lib/goblin/install/private/owner-password\nprintf '%s\\n' \"$goblin_hostname\" > /var/lib/goblin/install/private/hostname\nprintf '%s\\n' \"$goblin_source_ref\" > /var/lib/goblin/install/private/source-ref\nprintf 'http://%s\\n' \"$goblin_hostname\" > /var/lib/goblin/public-url\nrm -rf /var/lib/goblin/install/private/work\n\"$GOBLINCTL\" internal state init\nexec 9>&-\n\nstage 'Starting the installation status page'\nsystemctl daemon-reload\nsystemctl enable --now goblin-setup.service\nsetup_ready=false\nfor ((attempt=0; attempt<30; attempt++)); do\n  if curl --fail --silent --show-error --noproxy '*' --connect-timeout 2 --max-time 3 \\\n      --unix-socket /run/goblin-setup/health.sock http://127.0.0.1/setup/healthz --output \"$bootstrap_dir/setup-health.json\" && \\\n      \"$GOBLINCTL\" internal json-test \"$bootstrap_dir/setup-health.json\" setup true\n  then setup_ready=true; break; fi\n  sleep 1\ndone\nif [[ \"$setup_ready\" != true ]]; then printf 'The installation status page did not start.\\n' >&2; exit 1; fi\nstage 'Starting background installation'\n# Type=exec returns once the worker is launched, independent of cluster readiness.\nsystemctl enable --now goblin-installer.service\nprintf 'setup-ready\\n' > /var/lib/goblin/bootstrap-status\nprintf 'Follow installation progress: http://%s\\n' \"$goblin_hostname\"\n",
            "$fxv#2": "#!/bin/sh\nset -eu\n\nmkdir -p /var/lib/goblin\nprintf '%s\\n' failed > /var/lib/goblin/bootstrap-status\nprintf '%s\\n' 'Goblin installation failed during VM access-key setup: Azure did not supply the SSH public key. The installation cannot continue. Retry the portal deployment and complete the key-generation and download step.' >&2\nexit 1\n",
            "goblinctlRelease": "[variables('$fxv#0')]",
            "bootstrapScript": "[replace(replace(variables('$fxv#1'), '__GOBLINCTL_VERSION__', variables('goblinctlRelease').version), '__GOBLINCTL_SHA256__', variables('goblinctlRelease').sha256)]",
            "webRules": [
              {
                "name": "allow-http",
                "properties": {
                  "priority": 100,
                  "direction": "Inbound",
                  "access": "Allow",
                  "protocol": "Tcp",
                  "sourcePortRange": "*",
                  "destinationPortRange": "80",
                  "sourceAddressPrefix": "Internet",
                  "destinationAddressPrefix": "*"
                }
              },
              {
                "name": "allow-https",
                "properties": {
                  "priority": 110,
                  "direction": "Inbound",
                  "access": "Allow",
                  "protocol": "Tcp",
                  "sourcePortRange": "*",
                  "destinationPortRange": "443",
                  "sourceAddressPrefix": "Internet",
                  "destinationAddressPrefix": "*"
                }
              }
            ],
            "sshRules": "[if(or(empty(parameters('sshSourceAddressPrefix')), empty(trim(parameters('adminSshPublicKey')))), createArray(), createArray(createObject('name', 'allow-ssh', 'properties', createObject('priority', 120, 'direction', 'Inbound', 'access', 'Allow', 'protocol', 'Tcp', 'sourcePortRange', '*', 'destinationPortRange', '22', 'sourceAddressPrefix', parameters('sshSourceAddressPrefix'), 'destinationAddressPrefix', '*'))))]"
          },
          "resources": [
            {
              "type": "Microsoft.Network/networkSecurityGroups",
              "apiVersion": "2024-05-01",
              "name": "[parameters('names').networkSecurityGroup]",
              "location": "[parameters('location')]",
              "tags": "[parameters('tags')]",
              "properties": {
                "securityRules": "[concat(variables('webRules'), variables('sshRules'))]"
              }
            },
            {
              "type": "Microsoft.Network/virtualNetworks",
              "apiVersion": "2024-05-01",
              "name": "[parameters('names').virtualNetwork]",
              "location": "[parameters('location')]",
              "tags": "[parameters('tags')]",
              "properties": {
                "addressSpace": {
                  "addressPrefixes": [
                    "[parameters('virtualNetworkAddressPrefix')]"
                  ]
                },
                "subnets": [
                  {
                    "name": "[parameters('names').subnet]",
                    "properties": {
                      "addressPrefix": "[parameters('subnetAddressPrefix')]",
                      "networkSecurityGroup": {
                        "id": "[resourceId('Microsoft.Network/networkSecurityGroups', parameters('names').networkSecurityGroup)]"
                      },
                      "defaultOutboundAccess": false
                    }
                  }
                ]
              },
              "dependsOn": [
                "[resourceId('Microsoft.Network/networkSecurityGroups', parameters('names').networkSecurityGroup)]"
              ]
            },
            {
              "type": "Microsoft.Network/publicIPAddresses",
              "apiVersion": "2024-05-01",
              "name": "[parameters('names').publicIp]",
              "location": "[parameters('location')]",
              "tags": "[parameters('tags')]",
              "sku": {
                "name": "Standard"
              },
              "properties": {
                "publicIPAllocationMethod": "Static",
                "publicIPAddressVersion": "IPv4",
                "dnsSettings": {
                  "domainNameLabel": "[parameters('dnsLabel')]"
                }
              }
            },
            {
              "type": "Microsoft.Network/networkInterfaces",
              "apiVersion": "2024-05-01",
              "name": "[parameters('names').networkInterface]",
              "location": "[parameters('location')]",
              "tags": "[parameters('tags')]",
              "properties": {
                "ipConfigurations": [
                  {
                    "name": "primary",
                    "properties": {
                      "privateIPAllocationMethod": "Dynamic",
                      "subnet": {
                        "id": "[format('{0}/subnets/{1}', resourceId('Microsoft.Network/virtualNetworks', parameters('names').virtualNetwork), parameters('names').subnet)]"
                      },
                      "publicIPAddress": {
                        "id": "[resourceId('Microsoft.Network/publicIPAddresses', parameters('names').publicIp)]"
                      }
                    }
                  }
                ]
              },
              "dependsOn": [
                "[resourceId('Microsoft.Network/publicIPAddresses', parameters('names').publicIp)]",
                "[resourceId('Microsoft.Network/virtualNetworks', parameters('names').virtualNetwork)]"
              ]
            },
            {
              "type": "Microsoft.Compute/virtualMachines",
              "apiVersion": "2024-11-01",
              "name": "[parameters('names').virtualMachine]",
              "location": "[parameters('location')]",
              "tags": "[parameters('tags')]",
              "properties": {
                "hardwareProfile": {
                  "vmSize": "[parameters('vmSize')]"
                },
                "storageProfile": {
                  "imageReference": {
                    "publisher": "Canonical",
                    "offer": "ubuntu-24_04-lts",
                    "sku": "server",
                    "version": "latest"
                  },
                  "osDisk": {
                    "name": "[parameters('names').osDisk]",
                    "createOption": "FromImage",
                    "diskSizeGB": "[parameters('osDiskSizeGB')]",
                    "managedDisk": {
                      "storageAccountType": "StandardSSD_LRS"
                    },
                    "deleteOption": "Detach"
                  }
                },
                "osProfile": {
                  "computerName": "[parameters('names').virtualMachine]",
                  "adminUsername": "[parameters('adminUsername')]",
                  "linuxConfiguration": "[union(createObject('disablePasswordAuthentication', true(), 'provisionVMAgent', true()), if(empty(trim(parameters('adminSshPublicKey'))), createObject(), createObject('ssh', createObject('publicKeys', createArray(createObject('path', format('/home/{0}/.ssh/authorized_keys', parameters('adminUsername')), 'keyData', trim(parameters('adminSshPublicKey'))))))))]"
                },
                "securityProfile": {
                  "securityType": "TrustedLaunch",
                  "uefiSettings": {
                    "secureBootEnabled": true,
                    "vTpmEnabled": true
                  }
                },
                "networkProfile": {
                  "networkInterfaces": [
                    {
                      "id": "[resourceId('Microsoft.Network/networkInterfaces', parameters('names').networkInterface)]",
                      "properties": {
                        "primary": true,
                        "deleteOption": "Detach"
                      }
                    }
                  ]
                },
                "diagnosticsProfile": {
                  "bootDiagnostics": {
                    "enabled": true
                  }
                }
              },
              "dependsOn": [
                "[resourceId('Microsoft.Network/networkInterfaces', parameters('names').networkInterface)]"
              ]
            },
            {
              "type": "Microsoft.Compute/virtualMachines/extensions",
              "apiVersion": "2024-11-01",
              "name": "[format('{0}/{1}', parameters('names').virtualMachine, 'goblin-bootstrap')]",
              "location": "[parameters('location')]",
              "tags": "[parameters('tags')]",
              "properties": {
                "publisher": "Microsoft.Azure.Extensions",
                "type": "CustomScript",
                "typeHandlerVersion": "2.1",
                "autoUpgradeMinorVersion": true,
                "protectedSettings": {
                  "script": "[base64(if(and(parameters('requireSshPublicKey'), empty(trim(parameters('adminSshPublicKey')))), variables('$fxv#2'), replace(replace(replace(variables('bootstrapScript'), '__GOBLIN_HOSTNAME_BASE64__', base64(reference(resourceId('Microsoft.Network/publicIPAddresses', parameters('names').publicIp), '2024-05-01').dnsSettings.fqdn)), '__GOBLIN_SOURCE_REF_BASE64__', base64(parameters('goblinSourceRef'))), '__GOBLIN_PASSWORD_BASE64__', base64(parameters('goblinPassword')))))]"
                }
              },
              "dependsOn": [
                "[resourceId('Microsoft.Network/publicIPAddresses', parameters('names').publicIp)]",
                "[resourceId('Microsoft.Compute/virtualMachines', parameters('names').virtualMachine)]"
              ]
            }
          ],
          "outputs": {
            "publicIpAddress": {
              "type": "string",
              "value": "[reference(resourceId('Microsoft.Network/publicIPAddresses', parameters('names').publicIp), '2024-05-01').ipAddress]"
            },
            "publicHostname": {
              "type": "string",
              "value": "[reference(resourceId('Microsoft.Network/publicIPAddresses', parameters('names').publicIp), '2024-05-01').dnsSettings.fqdn]"
            },
            "virtualMachineResourceId": {
              "type": "string",
              "value": "[resourceId('Microsoft.Compute/virtualMachines', parameters('names').virtualMachine)]"
            }
          }
        }
      },
      "dependsOn": [
        "[subscriptionResourceId('Microsoft.Resources/resourceGroups', variables('names').resourceGroup)]"
      ]
    }
  ],
  "outputs": {
    "resourceNames": {
      "type": "object",
      "metadata": {
        "description": "Effective customer resource names, including any overrides."
      },
      "value": "[variables('names')]"
    },
    "publicIpAddress": {
      "type": "string",
      "metadata": {
        "description": "Public IPv4 address of the VM."
      },
      "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, variables('names').resourceGroup), 'Microsoft.Resources/deployments', 'goblin-infrastructure'), '2025-04-01').outputs.publicIpAddress.value]"
    },
    "publicHostname": {
      "type": "string",
      "metadata": {
        "description": "Azure-managed public hostname serving the Goblin UI over HTTP."
      },
      "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, variables('names').resourceGroup), 'Microsoft.Resources/deployments', 'goblin-infrastructure'), '2025-04-01').outputs.publicHostname.value]"
    },
    "goblinUrl": {
      "type": "string",
      "metadata": {
        "description": "Open this URL to follow installation progress. It opens Goblin when ready. HTTPS is configured separately."
      },
      "value": "[format('http://{0}', reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, variables('names').resourceGroup), 'Microsoft.Resources/deployments', 'goblin-infrastructure'), '2025-04-01').outputs.publicHostname.value)]"
    },
    "virtualMachineResourceId": {
      "type": "string",
      "metadata": {
        "description": "VM resource ID for administration through the Azure portal or CLI."
      },
      "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, variables('names').resourceGroup), 'Microsoft.Resources/deployments', 'goblin-infrastructure'), '2025-04-01').outputs.virtualMachineResourceId.value]"
    },
    "sshCommand": {
      "type": "string",
      "metadata": {
        "description": "SSH command using the saved private key. Replace the example key path with the downloaded file. Empty when no public key was supplied."
      },
      "value": "[if(empty(trim(parameters('adminSshPublicKey'))), '', format('ssh -i /path/to/saved-key.pem {0}@{1}', parameters('adminUsername'), reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, variables('names').resourceGroup), 'Microsoft.Resources/deployments', 'goblin-infrastructure'), '2025-04-01').outputs.publicHostname.value))]"
    },
    "sshAccessNote": {
      "type": "string",
      "metadata": {
        "description": "Instructions for later VM access. The private key is never included in deployment outputs."
      },
      "value": "[if(empty(trim(parameters('adminSshPublicKey'))), 'No SSH key was supplied. An authorized Azure administrator can add a new public key later.', format('Keep your matching private key for later VM access. {0}', if(empty(trim(parameters('sshSourceAddressPrefix'))), 'Public SSH is closed; an administrator must allow port 22 from your IP before connecting.', 'Public SSH is restricted to the configured source IP or CIDR.')))]"
    },
    "readinessCommand": {
      "type": "string",
      "metadata": {
        "description": "Command for checking installation progress through Azure Run Command, including before Kubernetes exists."
      },
      "value": "[format('az vm run-command invoke --ids {0} --command-id RunShellScript --scripts \"cat /var/lib/goblin/bootstrap-status /var/lib/goblin/install/status.json\"', reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, variables('names').resourceGroup), 'Microsoft.Resources/deployments', 'goblin-infrastructure'), '2025-04-01').outputs.virtualMachineResourceId.value)]"
    }
  }
}